---
// components
import Section from "@elements/Section.astro";
import ProjectCard from "@elements/ProjectCard.astro";

const locale = Astro.currentLocale ?? 'es';

// content collection
import { getCollection } from "astro:content";
const projects = await getCollection("projects");
const featuredProjects = projects.filter(project => project.data.isFeatured === true && project.data.lang === locale);

// localization
const content = {
  es: {
    title: "Proyectos Destacados",
    description: "Cosillas que he ido haciendo",
  },
  en: {
    title: "Featured Projects",
    description: "Some of the work I've done",
  }
}

const {title, description} = content[locale as 'es'|'en'] ?? content['es'];
---

<Section 
    aria-label={title}
    title={title}
    titleHeading={description}
>
    {
        featuredProjects.map((project) => (
            <ProjectCard 
                title={project.data.title}
                year={project.data.year}
                github={project.data.github}
                website={project.data.liveSite}
                description={project.data.description}
                tools={project.data.tools}
            />
        ))
    }
</Section>