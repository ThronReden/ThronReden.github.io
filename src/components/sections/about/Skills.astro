---
// components
import Section from "@elements/Section.astro";
import Tag from "@elements/Tag.astro";
import Text from "@elements/Text.astro";

// content collection
import { getCollection } from "astro:content";
import { undefined } from "astro:schema";
const skillsAndTools = await getCollection("skillsAndTools");

// localization
const locale = (Astro.currentLocale ?? 'es') as 'es'|'en';

const content = {
  es: {
    title: "Herramientas y Habilidades",
    heading: "Lo que sé, uso y sigo aprendiendo",
  },
  en: {
    title: "Tools and Skills",
    heading: "What I know, use & keep educating myself on",
  }
}

const {title, heading} = content[locale] ?? content['es'];
---

<Section
    aria-label={title}
    title={title}
    titleHeading={heading}
>
    {
        skillsAndTools.map((category) => (
            <div class="border-2 border-base-900">
                <div class="bg-base-900 p-16">
                    <Text variant={'lg'}>{category.data[locale].title}</Text>
                </div>
                <div class="p-16 flex flex-row flex-wrap gap-16">
                    {
                        (category.data.items.common?? []).concat(locale === 'es' ? (category.data.items.es?? []) : (category.data.items.en?? [])).map((tag) => (
                            <Tag title={tag} />
                        ))
                    }
                </div>
            </div>
        ))
    }
</Section>